  {% comment %} Posts - all language versions with hreflang {% endcomment %}
  {% assign ko_posts = site.posts | where: "locale", "ko" %}
  {% for post in ko_posts %}
  {% assign post_slug = post.url | split: '/posts/' | last | split: '/' | first %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}/posts/{{ post_slug }}/</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    <xhtml:link rel="alternate" hreflang="ko" href="{{ site.url }}{{ site.baseurl }}/posts/{{ post_slug }}/" />
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.url }}{{ site.baseurl }}/en/posts/{{ post_slug }}/" />
